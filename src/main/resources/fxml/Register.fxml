<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.epharmacy.controllers.RegisterController"
            fx:id="rootPane"
            styleClass="app-root"
            prefWidth="1100" prefHeight="720">

    <top>
        <fx:include source="includes/HeaderBar.fxml"/>
    </top>

    <center>
        <StackPane styleClass="login-container">
            <HBox styleClass="login-split" alignment="CENTER">
                <VBox styleClass="login-brand" alignment="TOP_LEFT">
                    <StackPane fx:id="loginBrandIcon" styleClass="login-brand-icon-wrap"/>
                    <Label text="Join as patient" styleClass="login-brand-title"/>
                    <Label text="Create your account to browse medicines, place orders, and upload prescriptions."
                           styleClass="login-brand-tagline"/>
                </VBox>

                <VBox alignment="TOP_LEFT" spacing="0" styleClass="login-card">
                    <Label text="Create account" styleClass="login-title"/>
                    <Label text="Patient registration â€” all fields required" styleClass="login-subtitle"/>

                    <GridPane hgap="14" vgap="8" maxWidth="400">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <Label text="Full name" styleClass="input-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label text="Email" styleClass="input-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="nameField" promptText="Mona Ali"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="emailField" promptText="mona@gmail.com"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Password" styleClass="input-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label text="Confirm password" styleClass="input-label" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <PasswordField fx:id="passwordField" promptText="6+ characters"
                                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <PasswordField fx:id="confirmField" promptText="Re-enter password"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="Phone" styleClass="input-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <Label text="Address" styleClass="input-label" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <TextField fx:id="phoneField" promptText="01xxxxxxxxx"
                                  GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                        <TextField fx:id="addressField" promptText="City, streetâ€¦"
                                  GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                    </GridPane>

                    <Region prefHeight="22"/>

                    <Button text="Create account" maxWidth="400" prefHeight="46"
                            styleClass="button,button-lg" onAction="#handleRegister"/>

                    <Region prefHeight="14"/>

                    <HBox alignment="CENTER" spacing="8">
                        <Label text="Already registered?" styleClass="label-secondary"/>
                        <Button text="Sign in" styleClass="button-ghost" onAction="#goToLogin"/>
                    </HBox>
                </VBox>
            </HBox>
        </StackPane>
    </center>
</BorderPane>
