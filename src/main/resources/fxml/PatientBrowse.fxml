<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.epharmacy.controllers.PatientBrowseController"
            fx:id="rootPane"
            styleClass="app-root"
            prefWidth="1200" prefHeight="750">
    <top>
        <fx:include source="includes/HeaderBar.fxml"/>
    </top>

    <left>
        <VBox styleClass="sidebar" spacing="4">
            <HBox styleClass="sidebar-brand" alignment="CENTER_LEFT" spacing="10">
                <StackPane fx:id="sidebarBrandMark" styleClass="sidebar-brand-mark"/>
                <VBox spacing="2">
                    <Label text="Smart E-Pharmacy" styleClass="sidebar-logo"/>
                    <Label text="Shop" styleClass="sidebar-tagline"/>
                </VBox>
            </HBox>
            <Separator/>
            <VBox styleClass="sidebar-nav">
                <Button fx:id="btnBack" text="Back to home"
                        styleClass="sidebar-btn" onAction="#goBack" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" styleClass="content-area-compact">
            <VBox styleClass="page-header">
                <Label text="SHOP" styleClass="page-eyebrow"/>
                <Label text="Browse medicines" styleClass="label-heading"/>
                <Label text="Search catalog, add to cart, and checkout securely" styleClass="page-subtitle"/>
            </VBox>

            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="toolbar">
                <TextField fx:id="searchField" promptText="Search medicinesâ€¦"
                           styleClass="toolbar-search" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnSearch" text="Search" styleClass="button,button-sm" onAction="#handleSearch"/>
                <Label text="Qty" styleClass="input-label"/>
                <Spinner fx:id="qtySpinner" prefWidth="88"/>
                <Button fx:id="btnAddCart" text="Add to cart"
                        styleClass="button,button-success,button-sm" onAction="#addToCart"/>
            </HBox>

            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Available medicines" styleClass="section-title"/>
                    <TableView fx:id="medicineTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="mNameCol" text="Name" prefWidth="160"/>
                            <TableColumn fx:id="mCategoryCol" text="Category" prefWidth="110"/>
                            <TableColumn fx:id="mPriceCol" text="Price" prefWidth="90"/>
                            <TableColumn fx:id="mQtyCol" text="Stock" prefWidth="70"/>
                            <TableColumn fx:id="mManufCol" text="Manufacturer" prefWidth="140"/>
                            <TableColumn fx:id="mRxCol" text="Rx" prefWidth="50"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox styleClass="card,form-panel" prefWidth="340" minWidth="300" spacing="8">
                    <Label text="Your cart" styleClass="form-panel-title"/>
                    <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" prefHeight="150" minHeight="100">
                        <columns>
                            <TableColumn fx:id="cNameCol" text="Medicine" prefWidth="130"/>
                            <TableColumn fx:id="cPriceCol" text="Price" prefWidth="70"/>
                            <TableColumn fx:id="cQtyCol" text="Qty" prefWidth="50"/>
                            <TableColumn fx:id="cSubtotalCol" text="Subtotal" prefWidth="80"/>
                        </columns>
                    </TableView>
                    <Button fx:id="btnRemoveCart" text="Remove selected"
                            styleClass="button,button-danger,button-sm"
                            onAction="#removeFromCart" maxWidth="Infinity"/>
                    <Separator/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Total" styleClass="section-title"/>
                        <Label fx:id="totalLabel" text="0.00" styleClass="label-stat"/>
                    </HBox>
                    <TextArea fx:id="invoiceSummary" prefRowCount="3" editable="false"
                              styleClass="invoice-summary" wrapText="true" minHeight="60" prefHeight="75"/>
                    <Label text="Payment method" styleClass="input-label"/>
                    <ComboBox fx:id="paymentCombo" maxWidth="Infinity"/>
                    <Button fx:id="btnCheckout" text="Complete purchase"
                            styleClass="button,button-success,button-lg"
                            onAction="#checkout" maxWidth="Infinity"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
